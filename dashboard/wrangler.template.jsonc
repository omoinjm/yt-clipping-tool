// TEMPLATE: tracked in git. scripts/dashboard.sh renders it to wrangler.jsonc (git-ignored) with
// placeholders filled from Infisical, so account IDs never land in the repo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clipper-dashboard",
  "account_id": "${CLOUDFLARE_ACCOUNT_ID}",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Icons + web manifest (generated by scripts/make-icons.py). Served at the edge, still behind Access.
  "assets": { "directory": "public" },
  "d1_databases": [
    { "binding": "DB", "database_name": "clipper", "database_id": "${D1_DATABASE_ID}", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "clipper-clips" }],
  "vars": {
    "YT_CATEGORY_ID": "22",
    // AWS Batch target for the "New source" form (key: secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY).
    "AWS_REGION": "eu-west-1",
    "BATCH_JOB_QUEUE": "clipper-gpu",
    "BATCH_JOB_DEFINITION": "clipper",
    "R2_BUCKET_NAME": "clipper-clips"
  }
  // Secrets (scripts/sync-worker-secrets.sh from Infisical): ACCESS_TEAM_DOMAIN, ACCESS_AUD,
  // INTERNAL_API_TOKEN, AWS_ACCESS_KEY_ID,
  // AWS_SECRET_ACCESS_KEY, YT_CLIENT_ID, YT_CLIENT_SECRET, YT_REFRESH_TOKEN
}
