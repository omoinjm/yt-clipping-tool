# Non-secret config only. Secrets live in Infisical (project njmtech-clipping, see .infisical.json):
#   run commands as `infisical run -- uv run clipper ...`

# Claude for clip selection: Amazon Bedrock by default (uses your AWS credentials, no API key).
CLAUDE_PROVIDER=bedrock
# ANTHROPIC_MODEL=eu.anthropic.claude-sonnet-4-6   (eu.anthropic.claude-opus-5-5 once enabled)
# CLAUDE_PROVIDER=anthropic + ANTHROPIC_API_KEY (in Infisical) to use the Claude API directly.

# WhisperX. CPU + 7GB RAM: small/int8. GPU: large-v3/float16.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=4
# WHISPER_LANGUAGE=en
# --diarize needs HF_TOKEN (in Infisical; accept pyannote terms on Hugging Face first)

CLIPS_PER_SOURCE=5

# YouTube: OAuth "Desktop app" client JSON from Google Cloud Console
YT_CLIENT_SECRETS=client_secret.json
YT_CATEGORY_ID=22
# REMOTION_CONCURRENCY=2

# ── Cloud mode (clipper submit / jobs) ──
AWS_REGION=eu-west-1
CLIPPER_S3_BUCKET=            # stack output WorkBucketName
CLIPPER_BATCH_QUEUE=clipper-gpu
CLIPPER_BATCH_JOBDEF=clipper
CLIPPER_API_URL=              # dashboard URL, e.g. https://clipper-dashboard.<sub>.workers.dev
# In Infisical: CLIPPER_API_TOKEN, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_ACCOUNT_ID, HF_TOKEN,
#               CF_ACCESS_CLIENT_ID, CF_ACCESS_CLIENT_SECRET, YT_CLIENT_ID, YT_CLIENT_SECRET
