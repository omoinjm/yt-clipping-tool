# Claude (clip selection). Or use `ant auth login` instead of a key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# WhisperX. CPU + 7GB RAM: small/int8. GPU: large-v3/float16.
WHISPER_MODEL=small
WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
WHISPER_BATCH_SIZE=4
# WHISPER_LANGUAGE=en
# Only needed for --diarize (accept pyannote terms on Hugging Face first)
HF_TOKEN=

CLIPS_PER_SOURCE=5

# YouTube: OAuth "Desktop app" client JSON from Google Cloud Console
YT_CLIENT_SECRETS=client_secret.json
YT_CATEGORY_ID=22
# REMOTION_CONCURRENCY=2

# ── Cloud mode (clipper submit / jobs) ──
AWS_REGION=eu-west-1
CLIPPER_S3_BUCKET=            # stack output WorkBucketName
CLIPPER_BATCH_QUEUE=clipper-gpu
CLIPPER_BATCH_JOBDEF=clipper
CLIPPER_API_URL=              # dashboard URL, e.g. https://clipper-dashboard.<sub>.workers.dev
CLIPPER_API_TOKEN=            # same value as the Worker's INTERNAL_API_TOKEN secret
CF_ACCESS_CLIENT_ID=          # Cloudflare Access service token
CF_ACCESS_CLIENT_SECRET=
